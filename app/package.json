{
  "name": "yawmi-local",
  "productName": "Yawmi Local",
  "version": "3.0.0",
  "description": "Yawmi Local — a private, offline day planner · مخطّط يومي محلي · Lokaler Tagesplaner",
  "author": "Yawmi",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/state.cjs && node --check dist/locales.js && node --check dist/i18n.js && node --check dist/plan-time.js && node --check dist/alarm.js && node --check dist/app.js",
    "test": "node --test tests/*.test.cjs",
    "build:dir": "electron-builder --win dir --x64",
    "build:win": "electron-builder --win portable nsis --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.yawmi.local",
    "productName": "Yawmi Local",
    "copyright": "Yawmi 2026",
    "asar": true,
    "npmRebuild": false,
    "directories": { "output": "release", "buildResources": "assets" },
    "files": ["electron/**/*.cjs", "dist/**/*", "assets/icon.ico", "assets/icon.png", "package.json"],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [{ "target": "portable", "arch": ["x64"] }, { "target": "nsis", "arch": ["x64"] }],
      "signExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": { "artifactName": "YawmiLocal-Portable-${version}-x64.exe" },
    "nsis": {
      "artifactName": "YawmiLocal-Setup-${version}-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yawmi Local",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  }
}
